---
interface Props {
 title: string;
 description: string;
 command?: string;
 actionHref?: string;
 actionLabel?: string;
}
const { title, description, command, actionHref, actionLabel } = Astro.props;
---
<section class="mt-9 border-t border-border py-10" aria-label={title}>
 <h2 class="text-lg font-medium tracking-tight text-foreground">{title}</h2>
 <p class="mt-2 max-w-prose text-sm leading-6 text-muted-foreground">{description}</p>
 {command && <div class="mt-6 w-fit max-w-full overflow-x-auto rounded-lg border border-border bg-card px-4 py-3"><code class="whitespace-nowrap font-mono text-xs text-foreground sm:text-sm">{command}</code></div>}
 {actionHref && actionLabel && <a href={actionHref} class="mt-6 inline-flex text-sm text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:decoration-foreground">{actionLabel}</a>}
</section>
